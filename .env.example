# Local dev overrides. Copy to `.env` (gitignored) and edit.
#
# Same keys as configs/config.yaml, with PORTFOLIO_ prefix and
# underscores replacing dots (PORTFOLIO_<SECTION>_<FIELD>).

# Override the dev port if 8080 is taken by another local service.
PORTFOLIO_SERVER_PORT=8089

# Email (uncomment + fill to test contact-form delivery locally).
# PORTFOLIO_EMAIL_PROVIDER=resend
# PORTFOLIO_EMAIL_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# PORTFOLIO_EMAIL_FROM=noreply@example.com
# PORTFOLIO_EMAIL_TO=you@example.com
